generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  AUDITOR
  CONSULTA
}

enum EstadoActivo {
  ACTIVO
  MANTENIMIENTO
  BAJA
}

model Usuario {
  id                 String    @id @default(uuid())
  nombre             String
  email              String    @unique
  passwordHash       String
  rol                Rol
  intentosFallidos   Int       @default(0)
  bloqueadoHasta     DateTime?
  creadoEn           DateTime  @default(now())
  refreshTokens      RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id          String   @id @default(uuid())
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash   String   @unique
  usado       Boolean  @default(false)
  reemplazadoPor String?
  expiraEn    DateTime
  creadoEn    DateTime @default(now())

  @@map("refresh_tokens")
}

model Activo {
  id                   String       @id @default(uuid())
  codigo               String       @unique
  nombre               String
  categoria            String
  ubicacion            String?
  estado               EstadoActivo @default(ACTIVO)
  responsable          String?
  fotoUrl              String?
  estadoActualizadoPor String?
  estadoActualizadoEn  DateTime?
  creadoEn             DateTime     @default(now())
  actualizadoEn        DateTime     @updatedAt

  @@map("activos")
}
